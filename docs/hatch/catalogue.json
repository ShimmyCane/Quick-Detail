    {
      "id": "02",
      "file": null,
      "title": "Engineering material notes, A to R (source image removed; entries are our own notes)",
      "entries": [
        {
          "name": "A: Cast or malleable iron, general use for all materials",
          "desc": "Evenly spaced diagonal lines. Also the default when a material is unlisted.",
          "basis": "seen"
        },
        {
          "name": "B: Steel",
          "desc": "Diagonal lines in closer pairs, heavier than A.",
          "basis": "seen"
        },
        {
          "name": "C: Bronze, brass, copper and compositions",
          "desc": "Diagonal lines with dashes between them.",
          "basis": "seen"
        },
        {
          "name": "D: White metal, zinc, lead, babbitt and alloys",
          "desc": "Crosshatch of diagonal lines in both directions.",
          "basis": "seen"
        },
        {
          "name": "E: Magnesium, aluminum and aluminum alloys",
          "desc": "Sparse X-shaped marks, short crossed strokes spaced apart.",
          "basis": "seen"
        },
        {
          "name": "F: Rubber, plastic and electrical insulation",
          "desc": "Diagonal lines in closely spaced pairs.",
          "basis": "seen"
        },
        {
          "name": "G: Cork, felt, leather and fiber",
          "desc": "Short wavy dashes in staggered rows.",
          "basis": "seen"
        },
        {
          "name": "H: Sound insulation",
          "desc": "Diagonal lines with small ovals scattered along them.",
          "basis": "seen"
        },
        {
          "name": "I: Thermal insulation",
          "desc": "Diagonal zigzag lines, like a sawtooth.",
          "basis": "seen"
        },
        {
          "name": "J: Titanium and refractory material",
          "desc": "Diagonal lines with short dashes between them.",
          "basis": "seen"
        },
        {
          "name": "K: Electric windings, electromagnets, resistance, etc.",
          "desc": "Square grid of fine lines.",
          "basis": "seen"
        },
        {
          "name": "L: Concrete",
          "desc": "Dense stipple with small triangles and irregular blobs.",
          "basis": "seen"
        },
        {
          "name": "M: Marble, slate, glass, porcelain, etc.",
          "desc": "Diagonal lines broken into short dashes.",
          "basis": "seen"
        },
        {
          "name": "N: Earth",
          "desc": "Bands of angled hatching sitting on a stipple base.",
          "basis": "seen"
        },
        {
          "name": "O: Rock",
          "desc": "Angular hatched blocks of irregular shape.",
          "basis": "seen"
        },
        {
          "name": "P: Sand",
          "desc": "Stipple of small dots, denser than concrete.",
          "basis": "seen"
        },
        {
          "name": "Q: Water and other liquids",
          "desc": "Horizontal lines, some broken into dashes.",
          "basis": "seen"
        },
        {
          "name": "R: Wood, across grain / with grain",
          "desc": "Across grain: concentric rings and arcs at the end grain. With grain: wavy lines that follow the growth.",
          "basis": "seen"
        }
      ]
    },
